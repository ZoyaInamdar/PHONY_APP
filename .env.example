# ==========================================
# Trigger-Aware Player — Environment Settings
# ==========================================

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Project configuration
CONFIG_PATH=config.yaml
FILM_ID=sintel

# Input media and pipeline outputs
MEDIA_DIR=data/media
DATA_DIR=data
DETECTIONS_DIR=data/detections
OUTPUT_DIR=output
REPORTS_DIR=reports
MODELS_DIR=models

# Pipeline execution
FORCE_REPROCESS=false
ENABLE_STRETCH_FEATURES=false

# Detector configuration
ENABLE_FLASH_DETECTOR=true
ENABLE_LOUDNESS_DETECTOR=true
ENABLE_AUDIO_EVENT_DETECTOR=true
ENABLE_PROFANITY_DETECTOR=true
ENABLE_VISUAL_OBJECT_DETECTOR=false

# Speech recognition
# Leave blank when using local speech recognition without an API.
SPEECH_API_KEY=

# AWS integration — optional
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Backend — optional
API_BASE_URL=http://localhost:8000