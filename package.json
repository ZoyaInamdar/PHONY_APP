{
  "name": "@amazon-devices/triggerawareplayer",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "react-native start",
    "start:player": "bash scripts/launch_player.sh",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "react-native build-vega --build-type Release",
    "build": "npm-run-all build:release",
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "lint": "eslint src test --ext .ts,.tsx",
    "lint:fix": "eslint src test --ext .ts,.tsx --fix",
    "release": "npm-run-all lint test build:app",
    "test:rn": "jest --colors --config jest.config.json",
    "test:snapshot": "jest --colors --updateSnapshot --config jest.config.json",
    "test": "jest --runInBand --config jest.config.js",
    "test:coverage": "jest --coverage --config jest.config.js",
    "typecheck": "tsc --noEmit --project tsconfig.engine.json",
    "results": "python3 scripts/results.py"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "^2.0.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "ajv": "^8.20.0",
    "react": "18.2.0",
    "react-native": "0.72.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "11.3.2",
    "@react-native/eslint-config": "0.72.2",
    "@react-native/metro-config": "^0.72.6",
    "@testing-library/react-native": "^7.2.0",
    "@tsconfig/react-native": "^3.0.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.30.0",
    "babel-jest": "^29.0.0",
    "eslint": "^8.12.0",
    "eslint-plugin-jest": "^26.5.3",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.76.5",
    "mustache": "^4.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.6.2",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "TriggerAwarePlayer",
    "targets": [
      "tv"
    ]
  }
}
