{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trigger-aware-player.org/schemas/config.schema.json",
  "title": "TriggerAwarePlayerConfig",
  "description": "Validation schema for Trigger-Aware Player shared pipeline configuration (config.yaml).",
  "type": "object",
  "required": [
    "version",
    "timeline",
    "detection",
    "triggers",
    "audio_processing",
    "visual_processing",
    "profanity",
    "merge",
    "evaluation",
    "experimental_features"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Configuration specification version."
    },
    "project_metadata": {
      "type": "object",
      "description": "Optional high-level metadata identifying the project and default film target."
    },
    "timeline": {
      "type": "object",
      "required": [
        "timestamp_unit",
        "interval_convention",
        "allow_fractional_seconds"
      ],
      "properties": {
        "timestamp_unit": {
          "type": "string",
          "enum": ["seconds"],
          "description": "Unit of timestamps across all detectors and cues. Must be 'seconds'."
        },
        "interval_convention": {
          "type": "string",
          "enum": ["half_open"],
          "description": "Mathematical interval convention. Must be 'half_open' [start, end)."
        },
        "allow_fractional_seconds": {
          "type": "boolean",
          "const": true,
          "description": "Whether fractional seconds (sub-second resolution) are allowed."
        },
        "reference_clock": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "detection": {
      "type": "object",
      "required": ["common_record_fields"],
      "properties": {
        "common_record_fields": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "start" },
          "description": "Mandatory record fields produced by all detectors: start, end, trigger, score, source."
        },
        "field_contracts": { "type": "object" },
        "score_semantics_note": { "type": "string" },
        "packaging_metadata_note": { "type": "string" },
        "field_naming_note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "triggers": {
      "type": "object",
      "required": [
        "flashing",
        "loud_spike",
        "gunshot",
        "explosion",
        "scream",
        "profanity",
        "spider",
        "fast_motion",
        "jump_scare"
      ],
      "properties": {
        "flashing": { "$ref": "#/$defs/trigger_definition" },
        "loud_spike": { "$ref": "#/$defs/trigger_definition" },
        "gunshot": { "$ref": "#/$defs/trigger_definition" },
        "explosion": { "$ref": "#/$defs/trigger_definition" },
        "scream": { "$ref": "#/$defs/trigger_definition" },
        "profanity": { "$ref": "#/$defs/trigger_definition" },
        "spider": { "$ref": "#/$defs/trigger_definition" },
        "fast_motion": { "$ref": "#/$defs/trigger_definition" },
        "jump_scare": { "$ref": "#/$defs/trigger_definition" }
      },
      "additionalProperties": { "$ref": "#/$defs/trigger_definition" }
    },
    "audio_processing": {
      "type": "object",
      "required": ["target_sample_rate_hz", "target_channels", "extraction"],
      "properties": {
        "target_sample_rate_hz": { "type": "integer", "minimum": 8000 },
        "target_channels": { "type": "integer", "const": 1 },
        "target_format": { "type": "string" },
        "extraction": { "type": "object" },
        "spectrogram": { "type": "object" }
      },
      "additionalProperties": true
    },
    "visual_processing": {
      "type": "object",
      "required": ["low_res_frames", "snapshot_sampling"],
      "properties": {
        "low_res_frames": { "type": "object" },
        "snapshot_sampling": { "type": "object" }
      },
      "additionalProperties": true
    },
    "profanity": {
      "type": "object",
      "required": [
        "primary_source",
        "default_padding_before_seconds",
        "default_padding_after_seconds"
      ],
      "properties": {
        "primary_source": { "type": "string", "enum": ["subtitles", "speech_to_text"] },
        "fallback_source": { "type": "string" },
        "subtitle_search_paths": { "type": "array", "items": { "type": "string" } },
        "word_list_path": { "type": "string" },
        "default_padding_before_seconds": { "type": "number", "minimum": 0.0 },
        "default_padding_after_seconds": { "type": "number", "minimum": 0.0 },
        "stt_fallback_enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "merge": {
      "type": "object",
      "required": [
        "group_by",
        "default_merge_gap_seconds",
        "max_segment_duration_seconds",
        "sort_order",
        "validation",
        "cross_trigger_policy"
      ],
      "properties": {
        "group_by": {
          "type": "object",
          "required": ["primary", "secondary"],
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" }
          }
        },
        "default_merge_gap_seconds": { "type": "number", "minimum": 0.0 },
        "max_segment_duration_seconds": { "type": "number", "minimum": 0.1 },
        "sort_order": {
          "type": "array",
          "items": { "type": "string" }
        },
        "validation": {
          "type": "object",
          "required": [
            "require_positive_duration",
            "allowed_trigger_ids",
            "missing_source_policy"
          ],
          "properties": {
            "require_positive_duration": { "type": "boolean" },
            "allowed_trigger_ids": { "type": "array", "items": { "type": "string" } },
            "missing_source_policy": { "type": "string", "enum": ["reject", "assign_unknown"] }
          }
        },
        "cross_trigger_policy": {
          "type": "object",
          "required": ["keep_separate", "allow_cross_trigger_merging"],
          "properties": {
            "keep_separate": { "type": "boolean", "const": true },
            "allow_cross_trigger_merging": { "type": "boolean", "const": false }
          }
        }
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "required": [
        "annotations_directory",
        "matching_criterion",
        "metrics",
        "evaluation_clips"
      ],
      "properties": {
        "annotations_directory": { "type": "string" },
        "ground_truth_filename_pattern": { "type": "string" },
        "matching_criterion": { "type": "string" },
        "tiou_threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "metrics": { "type": "array", "items": { "type": "string" } },
        "evaluation_clips": { "type": "object" },
        "reporting": { "type": "object" }
      },
      "additionalProperties": true
    },
    "experimental_features": {
      "type": "object",
      "required": ["stretch_features", "unresolved_model_selections"],
      "properties": {
        "stretch_features": { "type": "object" },
        "unresolved_model_selections": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "trigger_definition": {
      "type": "object",
      "required": [
        "display_name",
        "description",
        "enabled",
        "status",
        "modality",
        "method",
        "ml_model_required",
        "input",
        "timing_resolution_seconds",
        "source",
        "threshold",
        "default_action",
        "allowed_actions",
        "padding_before_seconds",
        "padding_after_seconds",
        "merge_gap_seconds",
        "min_segment_duration_seconds",
        "max_segment_duration_seconds"
      ],
      "properties": {
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "enabled": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["baseline", "experimental", "disabled"]
        },
        "modality": {
          "type": "string",
          "enum": ["visual", "audio", "text", "audio_visual"]
        },
        "method": { "type": "string" },
        "ml_model_required": { "type": "boolean" },
        "input": { "type": "string" },
        "timing_resolution_seconds": { "type": "number", "exclusiveMinimum": 0.0 },
        "source": { "type": "string" },
        "threshold": { "type": ["number", "object"] },
        "default_action": {
          "type": "string",
          "enum": ["dim", "mute", "blur", "skip", "warn"]
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["dim", "mute", "blur", "skip", "warn"]
          },
          "minItems": 1
        },
        "padding_before_seconds": { "type": "number", "minimum": 0.0 },
        "padding_after_seconds": { "type": "number", "minimum": 0.0 },
        "merge_gap_seconds": { "type": "number", "minimum": 0.0 },
        "min_segment_duration_seconds": { "type": "number", "exclusiveMinimum": 0.0 },
        "max_segment_duration_seconds": { "type": "number", "exclusiveMinimum": 0.0 },
        "algorithm": { "type": "object" },
        "classifier_settings": { "type": "object" },
        "matching_settings": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
