{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trigger-aware-player.org/schemas/insect_benchmark_annotation.schema.json",
  "title": "TriggerAwarePlayerInsectBenchmarkAnnotation",
  "description": "Validation schema for ground-truth annotations of the visual insect detector benchmark. Supports half-open reviewed intervals, positive insect presence, explicit human-verified negative intervals, and uncertain/unreviewed regions.",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "created_at",
    "description",
    "clips"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Annotation schema version."
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this benchmark annotation release."
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp of annotation generation."
    },
    "description": {
      "type": "string",
      "description": "High-level description of the annotated benchmark set."
    },
    "clips": {
      "type": "array",
      "description": "List of annotated clip records.",
      "items": {
        "$ref": "#/$defs/insect_clip_annotation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scenario_category": {
      "type": "string",
      "enum": [
        "crawling_insect",
        "flying_insect",
        "swarm",
        "spider_distractor",
        "spider_web_distractor",
        "foliage",
        "dust",
        "sparks",
        "bark",
        "clean_interior"
      ]
    },
    "split_type": {
      "type": "string",
      "enum": ["validation", "test"]
    },
    "annotation_status": {
      "type": "string",
      "enum": ["draft", "reviewed", "verified", "unreviewed"]
    },
    "temporal_interval": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0.0,
          "description": "Start timestamp in seconds (inclusive)."
        },
        "end": {
          "type": "number",
          "minimum": 0.0,
          "description": "End timestamp in seconds (exclusive)."
        },
        "label": {
          "type": "string",
          "description": "Optional sub-label or descriptor."
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Annotator confidence score in [0.0, 1.0]."
        },
        "notes": {
          "type": "string",
          "description": "Optional note on framing, motion blur, or ambiguity."
        }
      },
      "additionalProperties": false
    },
    "insect_clip_annotation": {
      "type": "object",
      "required": [
        "clip_id",
        "source_video_title",
        "media_path",
        "scenario_category",
        "split",
        "annotator",
        "annotation_status",
        "media_duration_seconds",
        "reviewed_intervals"
      ],
      "properties": {
        "clip_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique stable identifier for the clip."
        },
        "source_video_title": {
          "type": "string",
          "minLength": 1,
          "description": "Original source title or Wikimedia filename."
        },
        "media_path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to media file (portable, non-absolute)."
        },
        "scenario_category": {
          "$ref": "#/$defs/scenario_category"
        },
        "split": {
          "$ref": "#/$defs/split_type"
        },
        "annotator": {
          "type": "string",
          "minLength": 1,
          "description": "Name or identifier of the reviewer/annotator."
        },
        "annotation_status": {
          "$ref": "#/$defs/annotation_status"
        },
        "media_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "description": "Total duration of the media in seconds."
        },
        "reviewed_intervals": {
          "type": "array",
          "description": "Time intervals [start, end) that have been human-reviewed.",
          "items": {
            "$ref": "#/$defs/temporal_interval"
          }
        },
        "positive_intervals": {
          "type": "array",
          "description": "Time intervals [start, end) with confirmed insect presence.",
          "items": {
            "$ref": "#/$defs/temporal_interval"
          },
          "default": []
        },
        "explicit_negative_intervals": {
          "type": "array",
          "description": "Time intervals [start, end) confirmed insect-free by human review.",
          "items": {
            "$ref": "#/$defs/temporal_interval"
          },
          "default": []
        },
        "uncertain_intervals": {
          "type": "array",
          "description": "Time intervals [start, end) where insect presence is ambiguous or unverified.",
          "items": {
            "$ref": "#/$defs/temporal_interval"
          },
          "default": []
        },
        "notes": {
          "type": "string",
          "description": "Optional clip-level notes."
        }
      },
      "additionalProperties": false
    }
  }
}
