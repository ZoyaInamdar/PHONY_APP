{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/engine/**/*.ts",
    "src/subtitles/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "coverage",
    "src/App.tsx",
    "src/components",
    "src/data"
  ]
}
